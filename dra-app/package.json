{
  "name": "deployment-readiness-auditor",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "npx tsx watch server.ts",
    "dev": "npx tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.mjs --packages=external",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run build && node dist/server.mjs",
    "start:prod": "node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "diff": "^7.0.0",
    "driver.js": "^1.3.1",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.27.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
